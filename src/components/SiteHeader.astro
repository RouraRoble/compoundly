---
import { site } from '../site.config';
import { withBase, stripBase } from '../lib/url';
interface Props {
  links?: { href: string; label: string }[];
}
// Site-wide primary nav so the calculator hub, the invest hub and the explainers are reachable
// from every page (previously only via the sitemap or a base-less, broken link — see audit P1).
const DEFAULT_LINKS = [
  { href: '/', label: 'Calculator' },
  { href: '/calculator/', label: 'Calculator results' },
  { href: '/invest/', label: 'Monthly investing' },
  { href: '/rule-of-72/', label: 'Rule of 72' },
  { href: '/apy-vs-apr/', label: 'APY vs APR' },
  { href: '/about/', label: 'How it works' },
];
const { links = DEFAULT_LINKS } = Astro.props;
const current = stripBase(Astro.url.pathname);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={withBase('/')} aria-label={`${site.name} home`}>
      <img src={withBase('/favicon.svg')} alt="" width="28" height="28" />
      <span>{site.name}</span>
    </a>
    {
      links.length > 0 && (
        <nav aria-label="Primary">
          <ul class="nav">
            {links.map((l) => (
              <li>
                <a href={withBase(l.href)} aria-current={current === l.href ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(8px);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--fg);
    text-decoration: none;
    flex-shrink: 0;
  }
  /* The flex item is the plain <nav>, not the <ul class="nav"> inside it — a flex item's
     automatic min-width is its content's min-content size unless overridden, so without this the
     <nav> refuses to shrink below the full (unwrapped) link row and overflows the page instead of
     scrolling internally within the <ul>'s own overflow-x. */
  .site-header__inner nav {
    min-width: 0;
  }
  /* Nav never wraps into a tall sticky header: on narrow screens it scrolls horizontally instead.
     (Regression fix, audit-2 P1: 6 links used to wrap into up to 5 rows, making the sticky header
     193px tall at 320px and overlapping the brand.) */
  .nav {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    white-space: nowrap;
    max-width: 100%;
  }
  .nav::-webkit-scrollbar {
    display: none;
  }
  @media (max-width: 640px) {
    .site-header__inner {
      flex-wrap: wrap;
      row-gap: 0;
      /* Audit-3 P3: without this the brand sat flush against the very top edge of the screen. */
      padding-block: var(--space-2);
    }
    .nav {
      flex-basis: 100%;
      padding-bottom: var(--space-2);
    }
  }
  .nav a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    padding: var(--space-2) 0;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--fg);
  }
</style>
